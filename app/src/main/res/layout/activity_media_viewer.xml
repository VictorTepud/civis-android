<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Fullscreen zoomable image -->
    <com.civis.app.ui.media.ZoomableImageView
        android:id="@+id/ivFullscreenImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Imagen" />

    <!-- Video player -->
    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Loading spinner -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Video fullscreen button -->
    <ImageView
        android:id="@+id/ivFullscreenVideo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:padding="8dp"
        android:src="@drawable/ic_fullscreen"
        android:background="@drawable/bg_circle_semi_transparent"
        android:visibility="gone"
        android:contentDescription="Pantalla completa"
        app:tint="@android:color/white" />

    <!-- Top toolbar overlay -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_gradient_top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_sm">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="@dimen/spacing_xs"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white"
            android:contentDescription="Cerrar" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_md"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
